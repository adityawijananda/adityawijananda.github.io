---
import { experience } from '../data/portfolio';
---

<section class="exp section" id="experience" aria-labelledby="exp-heading">
  <div class="section__container">
    <header class="section__header">
      <p class="section__eyebrow">Career</p>
      <h2 class="section__title" id="exp-heading">Professional experience</h2>
    </header>

    <ol class="exp__list">
      {
        experience.map((job, i) => (
          <li class="exp__item">
            <div class="exp__marker" aria-hidden="true">
              <span class="exp__dot" />
              {i < experience.length - 1 ? <span class="exp__line" /> : null}
            </div>
            <article class="exp__card">
              <div class="exp__top">
                <h3 class="exp__role">{job.role}</h3>
                <p class="exp__company">{job.company}</p>
                <p class="exp__period">{job.period}</p>
              </div>
              <ul class="exp__highlights">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
  }

  .section__container {
    max-width: 880px;
    margin: 0 auto;
  }

  .section__header {
    margin-bottom: 2.75rem;
  }

  .section__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .exp__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .exp__item {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 1.25rem;
  }

  .exp__marker {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.35rem;
  }

  .exp__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #8a7038);
    box-shadow: 0 0 20px rgba(201, 169, 98, 0.45);
    flex-shrink: 0;
  }

  .exp__line {
    flex: 1;
    width: 1px;
    min-height: 2rem;
    background: linear-gradient(180deg, rgba(201, 169, 98, 0.45), transparent);
    margin-top: 0.5rem;
  }

  .exp__card {
    padding-bottom: 2.75rem;
  }

  .exp__item:last-child .exp__card {
    padding-bottom: 0;
  }

  .exp__top {
    margin-bottom: 1rem;
  }

  .exp__role {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
    letter-spacing: 0.02em;
  }

  .exp__company {
    margin: 0;
    font-size: 1rem;
    color: var(--accent);
    font-weight: 500;
  }

  .exp__period {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .exp__highlights {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-muted);
    font-weight: 300;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .exp__highlights li::marker {
    color: var(--accent);
  }
</style>
