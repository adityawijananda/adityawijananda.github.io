---
import { education } from '../data/portfolio';
---

<section class="edu section" id="education" aria-labelledby="edu-heading">
  <div class="section__container">
    <header class="section__header">
      <p class="section__eyebrow">Academic</p>
      <h2 class="section__title" id="edu-heading">Education</h2>
    </header>

    <ul class="edu__grid">
      {
        education.map((e) => (
          <li class="edu__card">
            <p class="edu__years">{e.years}</p>
            <h3 class="edu__school">{e.school}</h3>
            <p class="edu__degree">{e.degree}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
  }

  .section__container {
    max-width: 1120px;
    margin: 0 auto;
  }

  .section__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .edu__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .edu__card {
    padding: 1.75rem 1.65rem;
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(12px);
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .edu__card:hover {
    border-color: rgba(201, 169, 98, 0.2);
    transform: translateY(-2px);
  }

  .edu__years {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
    font-weight: 500;
  }

  .edu__school {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .edu__degree {
    margin: 0;
    color: var(--text-muted);
    font-weight: 300;
    font-size: 0.975rem;
  }
</style>
