---
import { leadership } from '../data/portfolio';
---

<section class="lead section" id="leadership" aria-labelledby="lead-heading">
  <div class="section__container">
    <header class="section__header">
      <p class="section__eyebrow">Leadership</p>
      <h2 class="section__title" id="lead-heading">Beyond code</h2>
    </header>

    <article class="lead__card">
      <div class="lead__meta">
        <h3 class="lead__role">{leadership.role}</h3>
        <p class="lead__org">{leadership.org}</p>
        <p class="lead__year">{leadership.year}</p>
      </div>
      <ul class="lead__list">
        {leadership.highlights.map((h) => <li>{h}</li>)}
      </ul>
    </article>
  </div>
</section>

<style>
  .section {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
  }

  .section__container {
    max-width: 880px;
    margin: 0 auto;
  }

  .section__header {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .section__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .lead__card {
    padding: 2rem 2rem 2.15rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(160deg, rgba(201, 169, 98, 0.09) 0%, var(--bg-card) 42%);
    backdrop-filter: blur(14px);
    box-shadow: var(--shadow-soft);
  }

  .lead__meta {
    margin-bottom: 1.35rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .lead__role {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 0.35rem;
  }

  .lead__org {
    margin: 0;
    color: var(--accent);
    font-weight: 500;
  }

  .lead__year {
    margin: 0.4rem 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .lead__list {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-muted);
    font-weight: 300;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .lead__list li::marker {
    color: var(--accent);
  }
</style>
